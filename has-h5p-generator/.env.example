# Public Supabase configuration (publishable/anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials. Never prefix these names with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
PREVIEW_TOKEN_SECRET=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional local H5P template; otherwise the server downloads it from private Storage.
PH5P_TEMPLATE_PATH=
